---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import MediaSplit from '@components/sections/landing/MediaSplit.astro';
import ImageCarousel from '@components/sections/landing/ImageCarousel.astro';
import { services } from '../../data/company';
import { getCopy } from '@/copy';
import { localePath, type MarketingLocale } from '@utils/locale';
import { routes } from '@utils/routes';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).services;

const serviceImages = [
  '/action-group/5.jpg',
  '/common/4.jpg',
  '/action-group/3.jpg',
  '/action-group/7.jpg',
  '/common/2.jpg',
];

const slides = [
  { src: '/action-group/1.jpg', alt: 'Servicio comercial Fluid', caption: 'Asesoramiento técnico-comercial' },
  { src: '/action-group/4.jpg', alt: 'Stock industrial', caption: 'Stock estratégico y entrega' },
  { src: '/action-group/6.jpg', alt: 'Cobertura nacional', caption: 'Cobertura comercial y técnica' },
  { src: '/action-group/8.jpg', alt: 'Proyectos especiales', caption: 'Proyectos y soluciones especiales' },
];
---

<MainLayout title={copy.title} description={copy.metaDescription} ogTitle={copy.ogTitle}>
  <section class="w-full py-12 lg:py-16">
    <div class="relative overflow-hidden rounded-3xl border border-fluid-cyan/20">
      <img src="/hero1.webp" alt="" class="absolute inset-0 h-full w-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-fluid-navy-deep/95 via-fluid-navy/85 to-fluid-navy/55" />
      <div class="relative px-6 py-14 text-white sm:px-10 lg:px-14 lg:py-20">
        <h1 class="max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl">
          {copy.intro.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg text-white/75">{copy.intro.subTitle}</p>
        <div class="mt-8">
          <PrimaryCTA title={copy.intro.cta} url={localePath(locale, routes.contact)} variant="cyan" />
        </div>
      </div>
    </div>
  </section>

  <section class="grid w-full gap-4 pb-10 md:grid-cols-2 lg:grid-cols-3">
    {services.map((service, index) => (
      <article class="overflow-hidden rounded-2xl border border-neutral-300 bg-white dark:border-neutral-700 dark:bg-neutral-900">
        <div class="aspect-[16/10] overflow-hidden">
          <img
            src={serviceImages[index] ?? '/common/1.jpg'}
            alt=""
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="p-6">
          <div class="h-1 w-12 rounded-full bg-gradient-to-r from-fluid-navy to-fluid-cyan" />
          <h2 class="mt-5 text-xl font-semibold text-fluid-navy dark:text-white">{service.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
            {service.description}
          </p>
        </div>
      </article>
    ))}
  </section>

  <ImageCarousel
    title="Cómo trabajamos"
    subTitle="Del relevamiento técnico a la entrega, con cobertura nacional."
    slides={slides}
  />

  <MediaSplit
    eyebrow="Cobertura"
    title={copy.stats.title}
    body={copy.stats.subTitle}
    imageSrc="/map.jpg"
    imageAlt="Mapa de cobertura Fluid"
    ctaLabel="Contactar"
    ctaHref={localePath(locale, routes.contact)}
  />

  <section class="w-full py-10 lg:pb-20">
    <div class="grid gap-4 sm:grid-cols-3">
      {copy.stats.stats.map((item) => (
        <div class="rounded-2xl border border-neutral-300 bg-white p-5 dark:border-neutral-700 dark:bg-neutral-900">
          <p class="text-2xl font-semibold text-fluid-navy dark:text-fluid-cyan-soft">{item.stat}</p>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{item.description}</p>
        </div>
      ))}
    </div>
  </section>
</MainLayout>
