---
import MainLayout from '@/layouts/MainLayout.astro';
import DemoForm from '@components/ui/forms/DemoForm.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { CHANNELS, CONTACT } from '../../data/contact-details';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).contact;
---

<MainLayout title={copy.title} description={copy.metaDescription} ogTitle={copy.ogTitle}>
  <section class="w-full py-12 lg:py-16">
    <div class="mb-10 overflow-hidden rounded-3xl border border-neutral-300 dark:border-neutral-700">
      <div class="relative aspect-[21/8] min-h-48">
        <img
          src="/hero6.webp"
          alt="Contacto Fluid Soluciones Dinámicas"
          class="absolute inset-0 h-full w-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-fluid-navy-deep/90 to-fluid-navy/40" />
        <div class="relative flex h-full flex-col justify-end p-6 sm:p-10">
          <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-5xl">
            {copy.heading}
          </h1>
          <p class="mt-4 max-w-2xl text-lg text-white/75">{copy.subTitle}</p>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="space-y-4">
        <div class="overflow-hidden rounded-2xl border border-neutral-300 dark:border-neutral-700">
          <img
            src="/action-group/2.jpg"
            alt="Atención comercial Fluid"
            class="aspect-[16/9] w-full object-cover"
            loading="lazy"
          />
        </div>
        {CHANNELS.map((channel) => (
          <article class="rounded-2xl border border-neutral-300 bg-white p-5 dark:border-neutral-700 dark:bg-neutral-900">
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-fluid-steel text-fluid-navy dark:bg-neutral-800 dark:text-fluid-cyan-soft">
                <Icon name={channel.icon} class="h-5 w-5" />
              </span>
              <h2 class="font-semibold text-fluid-navy dark:text-white">{channel.label}</h2>
            </div>
            <ul class="mt-4 space-y-2">
              {channel.actions.map((action) => (
                <li>
                  <a
                    href={action.href}
                    target={action.external ? '_blank' : undefined}
                    rel={action.external ? 'noopener noreferrer' : undefined}
                    class="text-sm text-neutral-700 underline-offset-2 hover:text-fluid-cyan hover:underline dark:text-neutral-300"
                  >
                    {action.text}
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
        <p class="text-sm text-neutral-500">{CONTACT.warehouseNote}</p>
      </div>

      <div class="rounded-3xl border border-neutral-300 bg-white p-6 sm:p-8 dark:border-neutral-700 dark:bg-neutral-900">
        <h2 class="text-2xl font-semibold text-fluid-navy dark:text-white">{copy.formTitle}</h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{copy.formSubTitle}</p>

        <DemoForm successMessage={copy.demoMessage}>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="mb-1.5 block text-neutral-700 dark:text-neutral-300">{copy.firstName}</span>
              <input
                type="text"
                name="firstName"
                class="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-fluid-cyan focus:ring-2 focus:ring-fluid-cyan/30 dark:border-neutral-600 dark:bg-neutral-950"
              />
            </label>
            <label class="block text-sm">
              <span class="mb-1.5 block text-neutral-700 dark:text-neutral-300">{copy.lastName}</span>
              <input
                type="text"
                name="lastName"
                class="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-fluid-cyan focus:ring-2 focus:ring-fluid-cyan/30 dark:border-neutral-600 dark:bg-neutral-950"
              />
            </label>
          </div>
          <label class="mt-4 block text-sm">
            <span class="mb-1.5 block text-neutral-700 dark:text-neutral-300">Email</span>
            <input
              type="email"
              name="email"
              required
              class="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-fluid-cyan focus:ring-2 focus:ring-fluid-cyan/30 dark:border-neutral-600 dark:bg-neutral-950"
            />
          </label>
          <label class="mt-4 block text-sm">
            <span class="mb-1.5 block text-neutral-700 dark:text-neutral-300">{copy.details}</span>
            <textarea
              name="details"
              rows="5"
              class="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-fluid-cyan focus:ring-2 focus:ring-fluid-cyan/30 dark:border-neutral-600 dark:bg-neutral-950"
            ></textarea>
          </label>
          <button
            type="submit"
            class="mt-6 inline-flex rounded-full bg-fluid-navy px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-fluid-cyan"
          >
            {copy.send}
          </button>
        </DemoForm>
      </div>
    </div>
  </section>
</MainLayout>
