---
import MainLayout from '@/layouts/MainLayout.astro';
import CategoryGrid from '@components/sections/landing/CategoryGrid.astro';
import { getCopy } from '@/copy';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const copy = getCopy(locale).productsIndex;
---

<MainLayout
  title={copy.title}
  description={copy.metaDescription}
  ogTitle={copy.ogTitle}
  kind={{ type: 'Product' }}
>
  <section class="w-full pt-10 sm:pt-12" data-reveal>
    <h1 class="text-3xl font-semibold tracking-tight text-fluid-ink sm:text-4xl md:text-5xl dark:text-white">
      {copy.heading}
    </h1>
    <p class="mt-4 max-w-3xl text-base text-neutral-600 sm:text-lg dark:text-neutral-400">{copy.subTitle}</p>
  </section>

  <CategoryGrid title="" subTitle="" />

  <section class="w-full py-10 lg:pb-20" data-reveal>
    <div class="rounded-3xl border border-neutral-300 bg-white p-6 sm:p-8 dark:border-neutral-700 dark:bg-neutral-900">
      <h2 class="text-2xl font-semibold text-fluid-navy dark:text-white">{copy.stats.title}</h2>
      <p class="mt-3 max-w-2xl text-neutral-600 dark:text-neutral-400">{copy.stats.subTitle}</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 md:grid-cols-3">
        {copy.stats.benefits.map((benefit) => (
          <li class="rounded-xl bg-fluid-steel/70 px-4 py-3 text-sm text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">
            {benefit}
          </li>
        ))}
      </ul>
    </div>
  </section>
</MainLayout>
