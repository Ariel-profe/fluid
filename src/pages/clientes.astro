---
import MainLayout from '@/layouts/MainLayout.astro';
import { PARTNERS } from '../../data/partners';
---

<MainLayout
  title="Clientes y partners"
  description="Empresas e industrias que confían en Fluid Soluciones Dinámicas para sus operaciones de control y conducción de fluidos."
  ogTitle="Clientes | Fluid"
>
  <section class="w-full py-12 lg:py-16">
    <p class="text-sm font-medium tracking-[0.16em] text-fluid-cyan uppercase dark:text-fluid-cyan-soft">
      Red de clientes
    </p>
    <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-fluid-ink sm:text-5xl dark:text-white">
      Clientes y partners
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
      Más de {PARTNERS.length} empresas de industria, agro, energía y minería confían en Fluid.
      Esta es la nómina completa de clientes destacados en nuestro manual institucional.
    </p>

    <ul
      class="mt-12 grid list-none grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6"
      data-reveal-group
    >
      {
        PARTNERS.map((partner) => (
          <li data-reveal-item>
            <article
              class="partner-tile group relative aspect-[5/3] overflow-hidden rounded-xl border border-neutral-300/90 bg-white transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-0.5 hover:border-fluid-cyan/45 hover:shadow-[0_14px_36px_-28px_rgba(11,42,74,0.55)] dark:border-white/12 dark:bg-white dark:hover:border-fluid-cyan/50"
              title={partner.name}
            >
              <img
                src={partner.logo}
                alt={partner.name}
                class="absolute inset-0 m-auto h-[58%] w-[72%] object-contain opacity-[0.92] transition-[opacity,transform] duration-300 group-hover:scale-[1.03] group-hover:opacity-100"
                loading="lazy"
              />
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>
