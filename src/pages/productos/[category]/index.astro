---
import CategoryView from '@views/CategoryView.astro';
import {
  categories,
  getCategoryBySlug,
  isCategoryNavigable,
} from '../../../../data/products';
import { routes } from '@utils/routes';

export function getStaticPaths() {
  return categories
    .filter((category) => isCategoryNavigable(category.id))
    .map((category) => ({
      params: { category: category.slug },
      props: { category },
    }));
}

const { category: categorySlug } = Astro.params;
const category =
  Astro.props.category ?? getCategoryBySlug(categorySlug ?? '');

if (!category || !isCategoryNavigable(category.id)) {
  return Astro.redirect(routes.products);
}
---

<CategoryView locale="es" category={category} />
