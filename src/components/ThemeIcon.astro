---
import Icon from '@components/ui/icons/Icon.astro';

const { copy: t } = Astro.locals;
---

<button
  type="button"
  aria-label={t.layout.darkTheme}
  title={t.layout.toggleTheme}
  class="hs-dark-mode group hs-dark-mode-active:hidden flex h-9 w-9 items-center justify-center rounded-lg text-neutral-600 outline-hidden ring-fluid-cyan transition duration-300 hover:bg-fluid-cyan/10 hover:text-fluid-navy dark:text-white/75 dark:hover:bg-fluid-cyan/10 dark:hover:text-fluid-cyan-soft dark:focus:outline-hidden"
  data-hs-theme-click-value="dark"
>
  <Icon name="moon" class="size-4 shrink-0" />
</button>
<button
  type="button"
  aria-label={t.layout.lightTheme}
  title={t.layout.toggleTheme}
  class="hs-dark-mode group hs-dark-mode-active:flex hidden h-9 w-9 items-center justify-center rounded-lg text-neutral-600 outline-hidden ring-fluid-cyan transition duration-300 hover:bg-fluid-cyan/10 hover:text-fluid-navy dark:text-white/75 dark:hover:bg-fluid-cyan/10 dark:hover:text-fluid-cyan-soft dark:focus:outline-hidden"
  data-hs-theme-click-value="default"
>
  <Icon name="sun" class="size-4.5 shrink-0" />
</button>
