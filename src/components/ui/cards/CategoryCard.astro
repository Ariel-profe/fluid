---
interface Props {
  name: string;
  description?: string;
  image?: string;
  href?: string;
  badge?: string;
  badgeTone?: 'available' | 'soon';
  meta?: string;
  cta?: string;
  /** Photographic covers fill the frame; product cutouts stay contained. */
  imageFit?: 'contain' | 'cover';
}

const {
  name,
  description,
  image,
  href,
  badge,
  badgeTone = 'available',
  meta,
  cta = 'Explorar →',
  imageFit = 'contain',
} = Astro.props;

const Wrapper = href ? 'a' : 'div';
---

<Wrapper
  href={href}
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white transition-[border-color,box-shadow] duration-300 dark:border-neutral-700 dark:bg-neutral-900',
    href
      ? 'hover:border-fluid-cyan/45 hover:shadow-[0_18px_40px_-28px_rgba(11,42,74,0.4)] dark:hover:border-fluid-cyan/35'
      : 'opacity-90',
  ]}
  data-reveal-item
>
  {image && (
    <div class="relative border-b border-neutral-100 bg-white dark:border-neutral-800">
      {badge && (
        <span
          class:list={[
            'absolute top-3 right-3 z-10 rounded-full px-2.5 py-1 text-xs font-medium',
            badgeTone === 'available'
              ? 'bg-fluid-cyan/15 text-fluid-navy dark:bg-fluid-cyan/20 dark:text-fluid-cyan-soft'
              : 'bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400',
          ]}
        >
          {badge}
        </span>
      )}
      {imageFit === 'cover' ? (
        <div class="media-reveal aspect-[4/3]">
          <img
            src={image}
            alt=""
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
            loading="lazy"
            data-reveal-media
          />
        </div>
      ) : (
        <div class="media-reveal flex aspect-[4/3] items-center justify-center px-4 py-5 sm:px-5 sm:py-6">
          <img
            src={image}
            alt=""
            class="mx-auto h-full max-h-40 w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.04] sm:max-h-44 md:max-h-48"
            loading="lazy"
            data-reveal-media
          />
        </div>
      )}
    </div>
  )}

  {!image && badge && (
    <div class="flex justify-end px-5 pt-4">
      <span
        class:list={[
          'rounded-full px-2.5 py-1 text-xs font-medium',
          badgeTone === 'available'
            ? 'bg-fluid-cyan/15 text-fluid-navy dark:bg-fluid-cyan/20 dark:text-fluid-cyan-soft'
            : 'bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400',
        ]}
      >
        {badge}
      </span>
    </div>
  )}

  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <h3 class="text-base font-semibold text-fluid-navy dark:text-white sm:text-lg">
      {name}
    </h3>
    {description && (
      <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        {description}
      </p>
    )}
    {meta && (
      <p class="mt-3 text-xs font-medium tracking-wide text-neutral-500 uppercase">
        {meta}
      </p>
    )}
    {href && (
      <p class="mt-auto pt-4 text-sm font-medium text-fluid-cyan dark:text-fluid-cyan-soft">
        {cta}
      </p>
    )}
  </div>
</Wrapper>
