---
import CardArrow from '@components/ui/buttons/CardArrow.astro';

interface Props {
  name: string;
  description?: string;
  image?: string;
  href?: string;
  badge?: string;
  badgeTone?: 'available' | 'soon';
  meta?: string;
  /** @deprecated Text CTAs replaced by CardArrow */
  cta?: string;
  imageFit?: 'contain' | 'cover';
}

const {
  name,
  description,
  image,
  href,
  badge,
  badgeTone = 'available',
  meta,
} = Astro.props;

const Wrapper = href ? 'a' : 'div';
---

<Wrapper
  href={href}
  class:list={[
    'group flex flex-col overflow-hidden rounded-2xl border border-neutral-200 bg-white transition-[border-color,box-shadow] duration-300 ease-out dark:border-zinc-700 dark:bg-zinc-900',
    href
      ? 'hover:border-fluid-navy/25 hover:shadow-[0_10px_28px_-22px_rgba(11,42,74,0.35)] dark:hover:border-fluid-cyan/30 dark:hover:shadow-[0_10px_28px_-22px_rgba(0,0,0,0.55)]'
      : 'opacity-90',
  ]}
  data-reveal-item
>
  {image && (
    <div class="relative border-b border-neutral-100 bg-white dark:border-neutral-800">
      {badge && (
        <span
          class:list={[
            'absolute top-2.5 right-2.5 z-10 rounded-full px-2.5 py-1 text-xs font-medium',
            badgeTone === 'available'
              ? 'bg-fluid-cyan/15 text-fluid-navy dark:bg-fluid-cyan/20 dark:text-fluid-cyan-soft'
              : 'bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400',
          ]}
        >
          {badge}
        </span>
      )}
      <div class="media-reveal mx-auto flex aspect-square w-full items-center justify-center">
        <img
          src={image}
          alt=""
          width="800"
          height="800"
          class="h-[80%] w-[80%] object-contain transition-transform duration-300 ease-out group-hover:scale-[1.02]"
          loading="lazy"
          decoding="async"
          data-reveal-media
        />
      </div>
    </div>
  )}

  {!image && badge && (
    <div class="flex justify-end px-4 pt-3">
      <span
        class:list={[
          'rounded-full px-2.5 py-1 text-xs font-medium',
          badgeTone === 'available'
            ? 'bg-fluid-cyan/15 text-fluid-navy dark:bg-fluid-cyan/20 dark:text-fluid-cyan-soft'
            : 'bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400',
        ]}
      >
        {badge}
      </span>
    </div>
  )}

  <div class="flex flex-col gap-1.5 p-3.5 sm:p-4">
    <div class="flex items-start justify-between gap-2.5">
      <div class="min-w-0">
        <h3 class="text-base font-semibold text-fluid-navy dark:text-white">
          {name}
        </h3>
        {meta && (
          <p class="mt-1 text-xs font-medium tracking-wide text-neutral-500 uppercase">
            {meta}
          </p>
        )}
      </div>
      {href && <CardArrow size="sm" class="mt-0.5" />}
    </div>
    {description && (
      <p class="line-clamp-2 text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        {description}
      </p>
    )}
  </div>
</Wrapper>
