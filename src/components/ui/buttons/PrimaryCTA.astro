---
import Icon from '@components/ui/icons/Icon.astro';
import type { IconName } from '@components/ui/icons/icons';

/**
 * The call-to-action button. Renders an `<a>` when given a `url`, otherwise a
 * `<button>` (give it an `id` to wire a script to it). Any other attribute
 * (`data-astro-prefetch`, `aria-*`, …) is forwarded to the element.
 */
interface Props {
  title?: string;
  url?: string;
  /** Fluid brand CTAs. */
  variant?: 'navy' | 'cyan' | 'orange' | 'blue';
  size?: 'md' | 'sm';
  /** Leading icon (e.g. chatBubble for Ventas). */
  icon?: IconName;
  noArrow?: boolean;
  [attribute: string]: unknown;
}

const {
  title,
  url,
  variant = 'navy',
  size = 'md',
  icon,
  noArrow,
  ...rest
} = Astro.props;

const variants = {
  navy: 'text-white bg-fluid-navy hover:bg-fluid-cyan active:bg-fluid-cyan',
  cyan: 'text-fluid-navy bg-fluid-cyan hover:bg-fluid-cyan-soft',
  orange:
    'text-neutral-50 bg-orange-400 hover:bg-orange-500 active:bg-orange-500',
  blue: 'text-neutral-800 bg-blue-400 hover:bg-blue-500',
};

const sizes = {
  md: 'rounded-lg px-5 py-3 text-sm 2xl:text-base',
  sm: 'rounded-lg px-3.5 py-2 text-sm',
};

const classes = [
  'group inline-flex items-center justify-center gap-x-2 font-bold ring-fluid-cyan transition duration-300 focus-visible:ring-3 outline-hidden',
  'border border-transparent',
  'hover:-translate-y-px active:translate-y-0',
  sizes[size],
  variants[variant],
  'disabled:pointer-events-none disabled:opacity-50 dark:focus:outline-hidden',
  'dark:ring-zinc-200',
].join(' ');

const Element = url ? 'a' : 'button';
---

<Element class={classes} href={url} {...rest}>
  {icon ? <Icon name={icon} class="h-4 w-4 shrink-0" /> : null}
  {title}
  {noArrow ? null : (
    <Icon
      name="arrowRight"
      class="h-4 w-4 shrink-0 transition duration-300 group-hover:translate-x-1"
    />
  )}
</Element>
