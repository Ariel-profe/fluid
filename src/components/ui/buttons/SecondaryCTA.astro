---
import Icon from '@components/ui/icons/Icon.astro';
import type { IconName } from '@components/ui/icons/icons';

interface Props {
  title?: string;
  url?: string;
  /** Leading icon (e.g. chatBubble for Ventas). */
  icon?: IconName;
}

const { title, url, icon } = Astro.props;
---

<a
  class="group inline-flex items-center justify-center gap-x-2 rounded-lg border border-white/25 bg-white/10 px-5 py-3 text-center text-sm font-medium text-white shadow-xs outline-hidden ring-fluid-cyan transition duration-300 hover:bg-white/20 focus-visible:ring-3 dark:border-white/20 dark:bg-white/10 dark:text-neutral-100 dark:hover:bg-white/15"
  href={url}
>
  {icon ? (
    <Icon
      name={icon}
      class="h-4 w-4 shrink-0 text-fluid-cyan-soft transition duration-300 group-hover:text-fluid-cyan"
    />
  ) : null}
  {title}
</a>
