---
import Icon from '@components/ui/icons/Icon.astro';
import type { IconName } from '@components/ui/icons/icons';

interface Props {
  url: string;
  name: string;
  icon?: IconName;
}

const { url, name, icon } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const target = url.replace(/\/$/, '') || '/';
const isActive =
  target === '/'
    ? pathname === '/'
    : pathname === target || pathname.startsWith(`${target}/`);
---

<a
  href={url}
  data-astro-prefetch
  data-nav-link
  aria-current={isActive ? 'page' : undefined}
  class:list={[
    'nav-link group relative inline-flex items-center gap-2.5 px-3.5 py-2.5 text-sm font-medium tracking-wide outline-hidden transition-colors duration-300 focus-visible:ring-2 focus-visible:ring-fluid-cyan/60 md:px-4 md:py-3',
    isActive
      ? 'text-fluid-cyan dark:text-fluid-cyan-soft'
      : 'text-neutral-600 hover:text-fluid-cyan dark:text-white/70 dark:hover:text-fluid-cyan-soft',
  ]}
>
  {
    icon && (
      <Icon
        name={icon}
        class={`h-4 w-4 shrink-0 transition-colors duration-300 ${
          isActive
            ? 'text-fluid-cyan dark:text-fluid-cyan-soft'
            : 'text-neutral-400 group-hover:text-fluid-cyan dark:text-white/40'
        }`}
      />
    )
  }
  {name}
</a>
