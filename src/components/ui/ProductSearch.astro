---
import Icon from '@components/ui/icons/Icon.astro';
import { getAllProducts, getProductHref } from '../../../data/products';

interface Props {
  /** `nav` = compacto en desktop; `panel` = bloque destacado del menú móvil. */
  variant?: 'nav' | 'panel';
  label?: string;
  hintPlaceholder?: string;
}

const {
  variant = 'nav',
  label,
  hintPlaceholder,
} = Astro.props;

const { copy: t } = Astro.locals;
const products = getAllProducts().map((product) => ({
  id: product.id,
  name: product.name,
  description: product.description ?? '',
  brand: product.brand ?? '',
  href: getProductHref(product),
  specs: (product.specs ?? []).map((s) => `${s.label} ${s.value}`).join(' '),
}));
const hint = t.layout.searchHint;
const empty = t.layout.searchNoResults;
const uid = `ps-${Math.random().toString(36).slice(2, 9)}`;
const isPanel = variant === 'panel';
const placeholder = hintPlaceholder ?? t.layout.searchPlaceholder;
---

<div
  class:list={[
    'relative',
    isPanel ? 'w-full' : 'w-full md:w-44 lg:w-56 xl:w-64',
  ]}
  data-product-search
  data-search-variant={variant}
  data-lenis-prevent
>
  {
    isPanel && label && (
      <label for={uid} class="mb-2 block text-sm font-medium text-fluid-navy dark:text-white">
        {label}
      </label>
    )
  }
  {!isPanel && <label class="sr-only" for={uid}>{t.layout.searchPlaceholder}</label>}

  <div class="relative">
    <span
      class:list={[
        'pointer-events-none absolute inset-y-0 left-0 flex items-center text-neutral-500 dark:text-white/45',
        isPanel ? 'pl-4' : 'pl-3',
      ]}
    >
      <Icon name="search" class={isPanel ? 'h-5 w-5' : 'h-4 w-4'} />
    </span>
    <input
      id={uid}
      type="search"
      autocomplete="off"
      enterkeyhint="search"
      placeholder={placeholder}
      class:list={[
        'w-full text-neutral-800 outline-none ring-fluid-cyan/40 transition placeholder:text-neutral-400 focus:border-fluid-cyan focus:ring-2 dark:text-neutral-100 dark:placeholder:text-white/40',
        isPanel
          ? 'min-h-12 rounded-xl border border-neutral-300/80 bg-white py-3 pr-4 pl-12 text-base shadow-sm dark:border-white/12 dark:bg-white/5'
          : 'rounded-lg border border-neutral-300/80 bg-white/90 py-2 pr-3 pl-9 text-sm dark:border-white/12 dark:bg-white/5',
      ]}
      data-product-search-input
    />
  </div>

  <div
    class:list={[
      'absolute z-50 hidden overflow-auto border border-neutral-200 bg-white p-2 shadow-xl dark:border-white/12 dark:bg-neutral-900',
      isPanel
        ? 'inset-x-0 bottom-[calc(100%+0.5rem)] max-h-[min(16rem,40dvh)] rounded-xl'
        : 'top-full mt-2 max-h-80 w-[min(24rem,calc(100vw-2rem))] rounded-xl',
    ]}
    data-product-search-results
    data-lenis-prevent
    role="listbox"
    hidden
  >
  </div>

  <script
    type="application/json"
    data-product-search-payload
    set:html={JSON.stringify({ products, hint, empty })}
  />
</div>

<script>
  import { initProductSearch } from '@scripts/productSearch';

  const boot = () => {
    const payload = document.querySelector('[data-product-search-payload]');
    if (!(payload instanceof HTMLScriptElement)) return;
    try {
      const parsed = JSON.parse(payload.textContent || '{}');
      initProductSearch(parsed.products ?? [], parsed.hint ?? '', parsed.empty ?? '');
    } catch {
      // ignore malformed payload
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
