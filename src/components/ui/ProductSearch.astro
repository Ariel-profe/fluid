---
import Icon from '@components/ui/icons/Icon.astro';
import { getAllProducts, getProductHref } from '../../../data/products';

const { copy: t } = Astro.locals;
const products = getAllProducts().map((product) => ({
  id: product.id,
  name: product.name,
  description: product.description ?? '',
  brand: product.brand ?? '',
  href: getProductHref(product),
  specs: (product.specs ?? []).map((s) => `${s.label} ${s.value}`).join(' '),
}));
const hint = t.layout.searchHint;
const empty = t.layout.searchNoResults;
const uid = `ps-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="relative w-full md:w-56 lg:w-72" data-product-search data-lenis-prevent>
  <label class="sr-only" for={uid}>{t.layout.searchPlaceholder}</label>
  <div class="relative">
    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-neutral-500">
      <Icon name="search" class="h-4 w-4" />
    </span>
    <input
      id={uid}
      type="search"
      autocomplete="off"
      placeholder={t.layout.searchPlaceholder}
      class="w-full rounded-full border border-neutral-300/80 bg-white/90 py-2 pr-3 pl-9 text-sm text-neutral-800 outline-none ring-fluid-cyan/40 transition placeholder:text-neutral-400 focus:border-fluid-cyan focus:ring-2 dark:border-neutral-600 dark:bg-neutral-900 dark:text-neutral-100"
      data-product-search-input
    />
  </div>
  <div
    class="absolute top-full z-50 mt-2 hidden max-h-80 w-[min(24rem,calc(100vw-2rem))] overflow-auto rounded-2xl border border-neutral-200 bg-white p-2 shadow-xl dark:border-neutral-700 dark:bg-neutral-900"
    data-product-search-results
    data-lenis-prevent
    role="listbox"
    hidden
  >
  </div>
  <script
    type="application/json"
    data-product-search-payload
    set:html={JSON.stringify({ products, hint, empty })}
  />
</div>

<script>
  import { initProductSearch } from '@scripts/productSearch';

  const boot = () => {
    const payload = document.querySelector('[data-product-search-payload]');
    if (!(payload instanceof HTMLScriptElement)) return;
    try {
      const parsed = JSON.parse(payload.textContent || '{}');
      initProductSearch(parsed.products ?? [], parsed.hint ?? '', parsed.empty ?? '');
    } catch {
      // ignore malformed payload
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
