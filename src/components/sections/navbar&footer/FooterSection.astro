---
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';
import { footerSections, socialLinks } from '@data/navigation';
import { CONTACT } from '../../../../data/contact-details';
import { localePath } from '@utils/locale';

const { locale, copy: t } = Astro.locals;
const footer = t.nav.footer;
---

<footer class="w-full border-t border-neutral-300/80 bg-fluid-navy text-white dark:border-neutral-800">
  <div class="mx-auto w-full max-w-(--breakpoint-2xl) px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:pt-16 lg:pb-12">
    <div class="grid gap-8 lg:grid-cols-4 lg:gap-10">
      <div>
        <a href={localePath(locale)} class="inline-flex items-center gap-3">
          <img src="/logo.webp" alt="" class="h-10 w-10 object-contain sm:h-12 sm:w-12" />
          <div>
            <p class="text-base font-semibold sm:text-lg">{SITE.title}</p>
            <p class="text-sm text-white/60">{SITE.tagline}</p>
          </div>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-white/65 sm:mt-4">
          {SITE.description_short}
        </p>
      </div>

      {/* Side-by-side on mobile; flatten into the 4-col grid on lg */}
      <div class="grid grid-cols-2 gap-6 lg:contents">
        {footerSections.map((section) => (
          <div>
            <h3 class="text-sm font-semibold text-white sm:text-base">
              {footer.sectionTitles[section.id]}
            </h3>
            <ul class="mt-3 space-y-2.5 sm:mt-4 sm:space-y-3">
              {section.links.map((link) => (
                <li>
                  <a
                    href={localePath(locale, link.path)}
                    class="text-sm text-white/65 transition hover:text-fluid-cyan-soft"
                  >
                    {footer.links[link.id]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div>
        <h3 class="text-sm font-semibold text-white sm:text-base">{footer.stayUpToDate}</h3>
        <p class="mt-3 text-sm text-white/65 sm:mt-4">{footer.stayUpToDateContent}</p>
        <div class="mt-4 flex flex-wrap gap-2.5 sm:mt-5 sm:gap-3">
          <a
            href={socialLinks.email}
            class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-3 py-2 text-sm text-white/80 hover:border-fluid-cyan/40 hover:text-fluid-cyan-soft"
          >
            <Icon name="envelopeOpen" class="h-4 w-4" />
            Email
          </a>
          <a
            href={socialLinks.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-3 py-2 text-sm text-white/80 hover:border-fluid-cyan/40 hover:text-fluid-cyan-soft"
          >
            <Icon name="whatsapp" class="h-4 w-4" />
            WhatsApp
          </a>
          <a
            href={socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-3 py-2 text-sm text-white/80 hover:border-fluid-cyan/40 hover:text-fluid-cyan-soft"
          >
            <Icon name="instagram" class="h-4 w-4" />
            Instagram
          </a>
        </div>
        <p class="mt-3 text-xs text-white/45 sm:mt-4">{CONTACT.address}</p>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-white/10 pt-5 sm:mt-12 sm:flex-row sm:items-center sm:justify-between sm:gap-3 sm:pt-6">
      <p class="text-sm text-white/50">
        © <span id="current-year"></span> {SITE.title}. {SITE.author}.
      </p>
      <p class="text-sm text-white/45">
        {footer.craftedBy}{' '}
        <a
          class="underline underline-offset-2 hover:text-fluid-cyan-soft"
          href="https://amn.com.ar"
          target="_blank"
          rel="noopener noreferrer"
        >
          AMN Consultora Informática
        </a>
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  const year = document.getElementById('current-year');
  if (year) year.textContent = String(new Date().getFullYear());
</script>
