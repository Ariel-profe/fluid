---
import ProductCard from '@components/ui/cards/ProductCard.astro';
import {
  categories,
  getCategoryHref,
  isCategoryNavigable,
} from '../../../../data/products';

interface Props {
  title: string;
  subTitle: string;
}

const { title, subTitle } = Astro.props;
---

<section class="w-full py-14 lg:py-20">
  {(title || subTitle) && (
    <div class="mb-10 max-w-3xl" data-reveal>
      {title && (
        <h2 class="text-3xl font-semibold tracking-tight text-fluid-ink sm:text-4xl dark:text-white">
          {title}
        </h2>
      )}
      {subTitle && (
        <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">{subTitle}</p>
      )}
    </div>
  )}

  <div
    class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
    data-reveal-group
  >
    {categories.map((category) => {
      const navigable = isCategoryNavigable(category.id);
      const modelCount = category.subcategories.reduce(
        (sum, sub) => sum + sub.products.length,
        0
      );
      return (
        <ProductCard
          name={category.name}
          image={category.image ?? '/categories/valvulas.webp'}
          imageFit="contain"
          href={navigable ? getCategoryHref(category) : undefined}
          badge={navigable ? 'Disponible' : 'Próximamente'}
          badgeTone={navigable ? 'available' : 'soon'}
          meta={
            navigable
              ? `${modelCount} modelo${modelCount === 1 ? '' : 's'}`
              : undefined
          }
        />
      );
    })}
  </div>
</section>
